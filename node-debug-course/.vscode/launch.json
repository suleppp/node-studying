{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "01 - 根目录 app.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/app.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "10 - Service Project",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/10-service-project/server.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "npm - Service Project",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "service"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach - 9229",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "continueOnAttach": true,
      "restart": false,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "11 - Supervisor + Child",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/11-supervisor/supervisor.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "19 - Capstone（故意有 bug）",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/labs/04-multitenant-cache-leak/app.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
